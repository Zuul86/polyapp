{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start (azurite)",
      "type": "shell",
      "command": "mkdir -p /tmp/azurite && (command -v azurite >/dev/null 2>&1 || npm install -g azurite) && if ! (echo >/dev/tcp/127.0.0.1/10000) >/dev/null 2>&1; then setsid azurite --silent --location /tmp/azurite --debug /tmp/azurite/debug.log </dev/null >/dev/null 2>&1 & for i in $(seq 1 50); do (echo >/dev/tcp/127.0.0.1/10000) >/dev/null 2>&1 && break; sleep 0.2; done; fi",
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "clean (functions)",
      "command": "dotnet",
      "args": [
        "clean",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/Dashboard.Api"
      }
    },
    {
      "label": "build (functions)",
      "command": "dotnet",
      "args": [
        "build",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "start (azurite)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/Dashboard.Api"
      }
    },
    {
      "label": "clean release (functions)",
      "command": "dotnet",
      "args": [
        "clean",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/Dashboard.Api"
      }
    },
    {
      "label": "publish (functions)",
      "command": "dotnet",
      "args": [
        "publish",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "clean release (functions)",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/Dashboard.Api"
      }
    },
    {
      "type": "func",
      "dependsOn": "build (functions)",
      "options": {
        "cwd": "${workspaceFolder}/src/Dashboard.Api/bin/Debug/net10.0"
      },
      "command": "host start",
      "args": [
        "--dotnet-isolated-debug",
        "--enable-json-output"
      ],
      "isBackground": true,
      "problemMatcher": "$func-dotnet-watch"
    },
    {
      "label": "trust (dev-certs)",
      "type": "shell",
      "command": "export SSL_CERT_DIR=\"$HOME/.aspnet/dev-certs/trust:/usr/lib/ssl/certs\" && (dotnet dev-certs https --check --trust >/dev/null 2>&1 || dotnet dev-certs https --trust)",
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "build (client)",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Dashboard.Client/Dashboard.Client.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "trust (dev-certs)",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/Dashboard.Client"
      }
    }
  ]
}