<div class="sidebar-header">
    <a class="sidebar-brand" href="">
        <span class="brand-cube">◆</span>
        @if (!IsCollapsed)
        {
            <span class="brand-text">MiniAppHub</span>
        }
    </a>
</div>

<nav class="sidebar-nav">
    <div class="nav-section-label">@(IsCollapsed ? "•••" : "VIEWS")</div>

    <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All" title="Public Dashboard">
        <span class="nav-icon">🌐</span>
        @if (!IsCollapsed)
        {
            <span>Public View</span>
        }
    </NavLink>

    <NavLink class="sidebar-link" href="private" title="Private Dashboard (Auth0 Protected)">
        <span class="nav-icon">🔒</span>
        @if (!IsCollapsed)
        {
            <span>Private View</span>
            <span class="nav-badge">Auth0</span>
        }
    </NavLink>

    <div class="nav-section-label">@(IsCollapsed ? "•••" : "MINI-APPS")</div>

    <NavLink class="sidebar-link" href="tools/token-generator" title="In-Browser 3D Token Generator">
        <span class="nav-icon">🪙</span>
        @if (!IsCollapsed)
        {
            <span>3D Token Generator</span>
        }
    </NavLink>
</nav>

@if (!IsCollapsed)
{
    <div class="sidebar-footer">
        <div class="sidebar-footer-card">
            <div class="footer-title">Stack Target</div>
            <div class="footer-meta">.NET 10 • Blazor WASM • Azure Functions v4</div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }
}
